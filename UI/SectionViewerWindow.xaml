<Window x:Class="ARAR.Civil3D.UI.SectionViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ARAR.Civil3D.UI"
        Title="Visor de secciones" Width="1120" Height="760" MinWidth="850" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#FFF3F5F7">
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Padding="8" Margin="0,0,0,8" Background="White" BorderBrush="#FFD4D9DE" BorderThickness="1" CornerRadius="4">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Corredor / baseline:" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="BaselineCombo" Width="360" DisplayMemberPath="Display" SelectionChanged="BaselineCombo_SelectionChanged"/>
          <TextBlock Text="Superficie:" VerticalAlignment="Center" Margin="14,0,6,0"/>
          <ComboBox x:Name="SurfaceCombo" Width="220" DisplayMemberPath="Name" SelectionChanged="SurfaceCombo_SelectionChanged"/>
          <Button x:Name="LoadButton" Content="Cargar secciones" Padding="12,5" Margin="12,0,0,0" Click="LoadButton_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="500"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="440" MinWidth="320" MaxWidth="760"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#FFD4D9DE" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid x:Name="ChartStackGrid" Grid.Row="0">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="SectionChartRow" Height="*"/>
              <RowDefinition x:Name="ProfileSplitterRow" Height="5"/>
              <RowDefinition x:Name="ProfileChartRow" Height="0"/>
            </Grid.RowDefinitions>
            <local:SectionCanvas x:Name="Canvas" Grid.Row="0"/>
            <GridSplitter x:Name="ProfileSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" Visibility="Collapsed" Background="#FFD4D9DE"/>
            <Grid Grid.Row="2" ClipToBounds="True">
              <local:LongitudinalProfileCanvas x:Name="ProfileCanvas"/>
            </Grid>
          </Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,5,12,0">
            <CheckBox x:Name="ShowEarthworkBox" Content="Sombreado desmonte/terraplén" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" Checked="DisplayOptions_Changed" Unchecked="DisplayOptions_Changed"/>
            <CheckBox x:Name="ShowShapesBox" Content="Sombreado de capas/shapes" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" Checked="DisplayOptions_Changed" Unchecked="DisplayOptions_Changed"/>
            <CheckBox x:Name="NeighborPreviousBox" Content="Anterior" Margin="0,0,8,0" VerticalAlignment="Center" Checked="NeighborOptions_Changed" Unchecked="NeighborOptions_Changed"/>
            <CheckBox x:Name="NeighborNextBox" Content="Siguiente" Margin="0,0,8,0" VerticalAlignment="Center" Checked="NeighborOptions_Changed" Unchecked="NeighborOptions_Changed"/>
            <CheckBox x:Name="NeighborTerrainBox" Content="Terreno vecino" Margin="0,0,8,0" VerticalAlignment="Center" Checked="NeighborOptions_Changed" Unchecked="NeighborOptions_Changed"/>
            <ComboBox x:Name="NeighborCountCombo" Width="45" SelectedIndex="0" Margin="0,0,12,0" SelectionChanged="NeighborOptions_Changed"><ComboBoxItem Content="1" Tag="1"/><ComboBoxItem Content="2" Tag="2"/><ComboBoxItem Content="3" Tag="3"/></ComboBox>
            <TextBlock Text="Exageración vertical:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock Text="PNG:" VerticalAlignment="Center" Margin="0,0,4,0"/><ComboBox x:Name="ImageResolutionCombo" Width="55" SelectedIndex="1" Margin="0,0,6,0"><ComboBoxItem Content="1x" Tag="1"/><ComboBoxItem Content="2x" Tag="2"/><ComboBoxItem Content="4x" Tag="4"/></ComboBox>
            <ComboBox x:Name="BackgroundModeCombo" Width="75" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="DisplayOptions_Changed"><ComboBoxItem Content="Claro" Tag="Light"/><ComboBoxItem Content="Oscuro" Tag="Dark"/></ComboBox>
            <ComboBox x:Name="VerticalScaleCombo" Width="75" SelectedIndex="0" SelectionChanged="DisplayOptions_Changed" VerticalAlignment="Center">
              <ComboBoxItem Content="1:1" Tag="1"/>
              <ComboBoxItem Content="1:2" Tag="2"/>
              <ComboBoxItem Content="1:5" Tag="5"/>
            </ComboBox>
          </StackPanel>
          <DockPanel Grid.Row="2" Margin="12,7" LastChildFill="True">
            <TextBlock x:Name="StationLabel" DockPanel.Dock="Left" Width="120" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Button DockPanel.Dock="Right" Content="Ajustar" Padding="8,4" Margin="6,0,0,0" Click="FitCanvas_Click"/>
            <Button DockPanel.Dock="Right" Content="Copiar" Padding="8,4" Margin="6,0,0,0" Click="CopyImage_Click"/>
            <Button DockPanel.Dock="Right" Content="Exportar PNG" Padding="8,4" Margin="6,0,0,0" Click="ExportImage_Click"/>
            <Button DockPanel.Dock="Right" Content="Dibujar DWG" Padding="8,4" Margin="6,0,0,0" Click="DrawSection_Click"/>
            <Button DockPanel.Dock="Right" Content="Centrar en PK" Padding="8,4" Margin="6,0,0,0" Click="CenterButton_Click"/>
            <Button DockPanel.Dock="Right" Content="Cursor en planta" Padding="8,4" Margin="6,0,0,0" Click="CursorButton_Click"/>
            <Slider x:Name="StationSlider" TickPlacement="BottomRight" IsSnapToTickEnabled="False" Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="StationSlider_ValueChanged"/>
          </DockPanel>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                    Cursor="SizeWE" Background="#FFD4D9DE"
                    ToolTip="Arrastre para cambiar el ancho del panel derecho"/>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <GroupBox Header="Ir a PK y favoritos" Padding="7" Margin="0,0,0,8">
            <StackPanel>
              <DockPanel Margin="0,0,0,5"><ComboBox x:Name="StationFormatCombo" Width="130" SelectedIndex="0" SelectionChanged="StationFormat_SelectionChanged"><ComboBoxItem Content="0+000.000" Tag="0"/><ComboBoxItem Content="0+000.00" Tag="1"/><ComboBoxItem Content="Metros 0.000" Tag="2"/></ComboBox><TextBlock Text="Formato PK" VerticalAlignment="Center" Margin="6,0,0,0"/></DockPanel>
              <DockPanel Margin="0,0,0,5"><Button DockPanel.Dock="Right" Content="Ir" Padding="9,3" Click="GoStation_Click"/><TextBox x:Name="GoStationText" ToolTip="Ejemplos: 1+250.000 o 1250" VerticalContentAlignment="Center" Margin="0,0,5,0"/></DockPanel>
              <TextBox x:Name="BookmarkNoteBox" Height="25" ToolTip="Nota del favorito" Margin="0,0,0,5"/>
              <DockPanel Margin="0,0,0,5"><ComboBox x:Name="BookmarkLabelCombo" Width="105" SelectedIndex="0"><ComboBoxItem Content="Revisar"/><ComboBoxItem Content="Conflicto"/><ComboBoxItem Content="Aprobada"/></ComboBox><Button Content="★ Guardar favorito" Padding="6,3" Margin="5,0,0,0" Click="SaveBookmark_Click"/></DockPanel>
              <ListBox x:Name="BookmarksList" Height="90" DisplayMemberPath="Display" SelectionChanged="BookmarksList_SelectionChanged"/>
              <DockPanel Margin="0,5,0,0"><Button Content="Ir al favorito" Padding="5,3" Click="GoBookmark_Click"/><Button Content="Actualizar nota" Padding="5,3" Margin="4,0,0,0" Click="UpdateBookmark_Click"/><Button Content="Eliminar" Padding="5,3" Margin="4,0,0,0" Click="DeleteBookmark_Click"/></DockPanel>
              <DockPanel Margin="0,5,0,0"><Button Content="Anterior ★" Padding="5,3" Click="PreviousBookmark_Click"/><Button Content="Siguiente ★" Padding="5,3" Margin="4,0,0,0" Click="NextBookmark_Click"/><Button Content="Exportar CSV" Padding="5,3" Margin="8,0,0,0" Click="ExportBookmarks_Click"/><Button Content="Importar CSV" Padding="5,3" Margin="4,0,0,0" Click="ImportBookmarks_Click"/></DockPanel>
              <TextBlock x:Name="NeighborDifferenceText" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#FF455A64"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Datos de sección" Padding="8" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock x:Name="CorridorText" TextWrapping="Wrap" Margin="0,2"/>
              <TextBlock x:Name="AlignmentText" TextWrapping="Wrap" Margin="0,2"/>
              <TextBlock x:Name="BaselineText" TextWrapping="Wrap" Margin="0,2"/>
              <TextBlock x:Name="RegionText" TextWrapping="Wrap" Margin="0,2"/>
              <TextBlock x:Name="AssemblyText" TextWrapping="Wrap" Margin="0,2"/>
              <Separator Margin="0,6"/>
              <TextBlock x:Name="ElevationText" TextWrapping="Wrap" Margin="0,2"/>
              <TextBlock x:Name="TerrainText" TextWrapping="Wrap" Margin="0,2"/>
              <TextBlock x:Name="DifferenceText" TextWrapping="Wrap" Margin="0,2"/>
              <TextBlock x:Name="CutFillText" TextWrapping="Wrap" Margin="0,2" FontWeight="SemiBold"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Áreas de capas del pavimento" Padding="5" Margin="0,0,0,8">
            <StackPanel>
              <DataGrid x:Name="PavementAreasGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        CanUserResizeColumns="True" HeadersVisibility="Column" MinHeight="130" MaxHeight="240"
                        MinColumnWidth="64" RowHeight="25" ColumnHeaderHeight="30" FontSize="12" ItemsSource="{Binding}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="" Width="28">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="●" Foreground="{Binding Swatch}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Capa" Binding="{Binding Name}" Width="*" MinWidth="90"/>
                  <DataGridTextColumn Header="Izq. m²" Binding="{Binding LeftText}" Width="78"/>
                  <DataGridTextColumn Header="Der. m²" Binding="{Binding RightText}" Width="78"/>
                  <DataGridTextColumn Header="Total m²" Binding="{Binding TotalText}" Width="82"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="PavementTotalText" Text="Total pavimento: 0.00 m²" FontWeight="SemiBold" Margin="3,4,0,0"/>
            </StackPanel>
          </GroupBox>
          <GroupBox x:Name="StakeGroup" Header="Cartera de rasante" Padding="5">
            <DataGrid x:Name="StakeGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="150" SelectionUnit="FullRow" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Nº" Binding="{Binding Number}" Width="34"/>
                <DataGridTextColumn Header="Punto" Binding="{Binding Description}" Width="145"/>
                <DataGridTextColumn Header="Offset (m)" Binding="{Binding OffsetText}" Width="72"/>
                <DataGridTextColumn Header="Rasante (m)" Binding="{Binding DesignText}" Width="82"/>
                <DataGridTextColumn Header="Terreno (m)" Binding="{Binding GroundText}" Width="82"/>
                <DataGridTextColumn Header="Δ (rasante - terreno)" Binding="{Binding DifferenceText}" Width="140"/>
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
          <TextBlock x:Name="StatusText" Text="Seleccione una baseline y una superficie, y cargue sus secciones." TextWrapping="Wrap" Foreground="#FF455A64" Margin="4,8,4,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
