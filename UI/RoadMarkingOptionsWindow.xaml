<Window x:Class="ARAR.Civil3D.UI.RoadMarkingOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dibujar Marca vial" SizeToContent="WidthAndHeight" MinWidth="410"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FFF3F5F7">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <GroupBox Header="Origen" Padding="8" Margin="0,0,0,8">
      <StackPanel>
        <RadioButton x:Name="ExistingOriginRadio" Content="Desde objeto existente" GroupName="Origin" IsChecked="True" Margin="0,2"/>
        <RadioButton x:Name="NewOriginRadio" Content="Dibujar nueva" GroupName="Origin" Margin="0,2"/>
      </StackPanel>
    </GroupBox>
    <GroupBox Grid.Row="1" Header="Parámetros de la marca" Padding="8" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Ancho de línea (m):" VerticalAlignment="Center" Margin="3"/>
        <TextBox x:Name="WidthText" Grid.Column="1" Text="0.10" Margin="3"/>
        <TextBlock Grid.Row="1" Text="Color:" VerticalAlignment="Center" Margin="3"/>
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="3">
          <Button x:Name="OtherColorButton" DockPanel.Dock="Right" Content="Otro…" Padding="7,3" Click="OtherColorButton_Click"/>
          <ComboBox x:Name="ColorCombo" SelectionChanged="ColorCombo_SelectionChanged">
            <ComboBoxItem Content="Blanco" Tag="7" IsSelected="True"/><ComboBoxItem Content="Amarillo" Tag="2"/>
            <ComboBoxItem Content="Azul" Tag="5"/><ComboBoxItem Content="Rojo" Tag="1"/><ComboBoxItem Content="Verde" Tag="3"/>
          </ComboBox>
        </DockPanel>
        <TextBlock Grid.Row="2" Text="Tipo de línea:" VerticalAlignment="Center" Margin="3"/>
        <ComboBox x:Name="LinetypeCombo" Grid.Row="2" Grid.Column="1" Margin="3" SelectionChanged="LinetypeCombo_SelectionChanged">
          <ComboBoxItem Content="Continua" Tag="Continuous" IsSelected="True"/><ComboBoxItem Content="Discontinua" Tag="Dashed"/>
        </ComboBox>
        <TextBlock Grid.Row="3" Text="Longitud de raya (m):" VerticalAlignment="Center" Margin="3"/>
        <TextBox x:Name="DashText" Grid.Row="3" Grid.Column="1" Text="4.00" Margin="3" IsEnabled="False"/>
        <TextBlock Grid.Row="4" Text="Espacio entre rayas (m):" VerticalAlignment="Center" Margin="3"/>
        <TextBox x:Name="GapText" Grid.Row="4" Grid.Column="1" Text="3.00" Margin="3" IsEnabled="False"/>
      </Grid>
    </GroupBox>
    <TextBlock x:Name="ValidationText" Grid.Row="2" Foreground="#FFB3261E" TextWrapping="Wrap" MinHeight="20" Margin="2,0,2,8"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Aceptar" Width="95" IsDefault="True" Margin="0,0,8,0" Click="AcceptButton_Click"/>
      <Button Content="Cancelar" Width="95" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
