<Window x:Class="ARAR.Civil3D.UI.AddinInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de ARAR-C3D" SizeToContent="WidthAndHeight" MinWidth="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FFF3F5F7">
  <Border Margin="12" Padding="18" Background="White" BorderBrush="#FFD4D9DE" BorderThickness="1" CornerRadius="4">
    <StackPanel>
      <TextBlock Text="ARAR-C3D está cargado y la cinta está operativa." FontSize="14" Margin="0,0,0,10"/>
      <TextBlock Text="Esto es un proyecto desarrollado por Adrián Angulo en Urci Consultores" FontSize="14" TextWrapping="Wrap"/>
      <Button Content="Aceptar" IsDefault="True" Width="95" HorizontalAlignment="Right" Margin="0,14,0,0" Click="AcceptButton_Click"/>
    </StackPanel>
  </Border>
</Window>
