<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RootNamespace>ARAR.Civil3D</RootNamespace>
    <AssemblyName>ARAR.Civil3D</AssemblyName>
    <Civil3DInstallDir Condition="'$(Civil3DInstallDir)' == ''">C:/Program Files/Autodesk/AutoCAD 2026</Civil3DInstallDir>
    <Civil3DApiDir Condition="'$(Civil3DApiDir)' == '' and Exists('$(Civil3DInstallDir)/C3D/AeccDbMgd.dll')">$(Civil3DInstallDir)/C3D</Civil3DApiDir>
    <Civil3DApiDir Condition="'$(Civil3DApiDir)' == ''">$(Civil3DInstallDir)</Civil3DApiDir>
    <CivilAecDir Condition="'$(CivilAecDir)' == '' and Exists('$(Civil3DInstallDir)/AecBaseMgd.dll')">$(Civil3DInstallDir)</CivilAecDir>
    <CivilAecDir Condition="'$(CivilAecDir)' == '' and Exists('$(Civil3DInstallDir)/ACA/AecBaseMgd.dll')">$(Civil3DInstallDir)/ACA</CivilAecDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Installer\Bootstrapper.cs" />
    <Reference Include="AcMgd" HintPath="$(Civil3DInstallDir)/AcMgd.dll" Private="false" />
    <Reference Include="AcDbMgd" HintPath="$(Civil3DInstallDir)/AcDbMgd.dll" Private="false" />
    <Reference Include="AcCoreMgd" HintPath="$(Civil3DInstallDir)/AcCoreMgd.dll" Private="false" />
    <Reference Include="AdWindows" HintPath="$(Civil3DInstallDir)/AdWindows.dll" Private="false" />
    <Reference Include="AecBaseMgd" HintPath="$(CivilAecDir)/AecBaseMgd.dll" Private="false" Condition="'$(CivilAecDir)' != ''" />
    <Reference Include="AeccDbMgd" HintPath="$(Civil3DApiDir)/AeccDbMgd.dll" Private="false" Condition="Exists('$(Civil3DApiDir)/AeccDbMgd.dll')" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\RoadMarking16.png" LogicalName="ARAR.Civil3D.Resources.RoadMarking16.png" />
    <EmbeddedResource Include="Resources\RoadMarking32.png" LogicalName="ARAR.Civil3D.Resources.RoadMarking32.png" />
    <EmbeddedResource Include="Resources\RoadMarking3D16.png" LogicalName="ARAR.Civil3D.Resources.RoadMarking3D16.png" />
    <EmbeddedResource Include="Resources\RoadMarking3D32.png" LogicalName="ARAR.Civil3D.Resources.RoadMarking3D32.png" />
    <EmbeddedResource Include="Resources\Icons\01_acerca_de_ARAR-C3D.png" LogicalName="ARAR.Civil3D.Resources.Icons.01_acerca_de_ARAR-C3D.png" />
    <EmbeddedResource Include="Resources\Icons\02_informacion_del_dibujo.png" LogicalName="ARAR.Civil3D.Resources.Icons.02_informacion_del_dibujo.png" />
    <EmbeddedResource Include="Resources\Icons\03_dibujar_marca_vial.png" LogicalName="ARAR.Civil3D.Resources.Icons.03_dibujar_marca_vial.png" />
    <EmbeddedResource Include="Resources\Icons\04_marca_vial_3D.png" LogicalName="ARAR.Civil3D.Resources.Icons.04_marca_vial_3D.png" />
    <EmbeddedResource Include="Resources\Icons\05_subir_solidos_a_superficie.png" LogicalName="ARAR.Civil3D.Resources.Icons.05_subir_solidos_a_superficie.png" />
    <EmbeddedResource Include="Resources\Icons\06_cebreado.png" LogicalName="ARAR.Civil3D.Resources.Icons.06_cebreado.png" />
    <EmbeddedResource Include="Resources\Icons\07_visor_de_secciones.png" LogicalName="ARAR.Civil3D.Resources.Icons.07_visor_de_secciones.png" />
    <EmbeddedResource Include="Resources\Icons\tabla_volumenes.png" LogicalName="ARAR.Civil3D.Resources.Icons.tabla_volumenes.png" />
    <EmbeddedResource Include="Resources\Icons\exportar_excel.png" LogicalName="ARAR.Civil3D.Resources.Icons.exportar_excel.png" />
  </ItemGroup>
</Project>
